{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/produto/:id",
      "destination": "/index.html"
    },
    {
      "source": "/lista",
      "destination": "/index.html"
    },
    {
      "source": "/carrinho",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/login",
      "destination": "/index.html"
    }
  ]
}